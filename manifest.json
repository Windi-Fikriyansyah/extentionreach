{
  "manifest_version": 3,
  "name": "ReachOwl Background Bridge",
  "version": "2.0.0",
  "description": "Silent background bridge for ReachOwl. Automates social account detection without buttons or popups.",
  "permissions": [
    "cookies",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.instagram.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ReachOwl Silent Bridge"
  }
}