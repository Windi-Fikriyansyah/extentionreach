{
  "manifest_version": 3,
  "name": "ReachOwl Background Bridge",
  "version": "2.1.0",
  "description": "Silent background bridge for ReachOwl. Automates social account detection with real profile extraction.",
  "permissions": [
    "cookies",
    "tabs",
    "alarms",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.instagram.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.facebook.com/*"
      ],
      "js": [
        "facebook-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ReachOwl Silent Bridge"
  }
}